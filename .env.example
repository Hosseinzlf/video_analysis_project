GOOGLE_API_KEY=your_key_here
LLM_PROVIDER=google

UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp
LOG_DIR=logs

MAX_FILE_SIZE=100000000
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv,webm
MAX_VIDEO_DURATION=300
MIN_FRAMES=5
MAX_FRAMES=15
DEFAULT_FRAMES=10

SCENE_THRESHOLD=27.0
MIN_SCENE_LENGTH=15

FRAME_QUALITY=85
MAX_FRAME_DIMENSION=1920

# Optional: uncomment and set if ffprobe is not on PATH
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
